NODE_ENV=development
PORT=3000
CORS_ORIGIN=chrome-extension://YOUR_EXTENSION_ID

# From the Google Sheet URL:
SPREADSHEET_ID=1Rerd3RwZfpt4qcuKHvOjAXFG0W-P69QmGfyBY-1zVq0

# Option A: service account JSON file path. Share the Google Sheet with the
# service account email from this JSON file.
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Option B: env-based service account credentials.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini AI parser fallback. Keep the real key only in .env or hosting secrets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

TIKTOK_FETCH_TIMEOUT_MS=8000
SHEET_POLL_INTERVAL_MS=60000

